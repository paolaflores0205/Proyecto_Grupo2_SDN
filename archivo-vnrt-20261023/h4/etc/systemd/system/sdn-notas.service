[Unit]
Description=SDN G2 fictional privileged notes resource - step 6
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sdn-notas-paso6
ExecStart=/usr/bin/python3 /opt/sdn-notas-paso6/vnrt_notas_https_paso6.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
